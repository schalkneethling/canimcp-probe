// Throwaway spike Worker for issue #1. Every key below was checked against
// https://developers.cloudflare.com/workers/wrangler/configuration/index.md
// (read 2026-11-12, page last updated 2026-11-11) and against the installed
// node_modules/wrangler/config-schema.json (wrangler 4.160.1).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "canimcp-probe-spike-1",
  "main": "src/worker.ts",
  // The newest date the installed workerd (1.20261110.1) supports. For dates of
  // 2026-08-04 or later, nodejs_compat and nodejs_compat_v2 are on by default.
  "compatibility_date": "2026-11-10",
  // Deliberately empty: the spike found that no flag is needed. See
  // docs/adr/0001-sdk-strategy.md, "Compatibility flags".
  "compatibility_flags": [],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canimcp-probe-spike-1",
      // Placeholder for local mode. The owner replaces it with the id printed by
      // `wrangler d1 create canimcp-probe-spike-1` before any remote command.
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // The MCP endpoints and the spike's runtime check must reach the Worker;
    // everything else is a static file.
    "run_worker_first": ["/mcp", "/mcp-d1", "/__runtime"],
  },
  // Declared only to check the binding's config shape; the spike never calls it.
  "ratelimits": [
    {
      "name": "PROBE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  // Invocation logs hold "the Request, Response, and related metadata"
  // (Workers Logs page), so they are off. The deployed CPU measurement reads
  // the Workers metrics instead (scripts/owner-cpu-graphql.ts), which need no
  // request logging.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false,
    },
  },
  "env": {
    // FALLBACK ONLY, for owner-run step 4b. Deploy it only if the GraphQL
    // Analytics API cannot give p95, and delete it straight after with
    // `npx wrangler delete --env with-invocation-logs`. It deploys a separate
    // Worker named canimcp-probe-spike-1-with-invocation-logs
    // (https://developers.cloudflare.com/workers/wrangler/environments/).
    // Bindings are not inheritable, so D1 and the rate limiter are restated.
    "with-invocation-logs": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "canimcp-probe-spike-1",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "PROBE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60,
          },
        },
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": true,
        },
      },
    },
  },
}
